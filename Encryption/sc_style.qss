/* sc_style.qss */
QWidget {
  color: #e9f2eb;
  font-size: 10pt;
}

QMainWindow, QWidget#ForestBackdrop {
  background: transparent;
}

QFrame#HeaderBar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 #2a1a10,
                              stop:0.40 #4a2f1b,
                              stop:0.70 #3b2516,
                              stop:1 #24160f);
  border: 1px solid rgba(0, 0, 0, 140);
  border-radius: 16px;
}

QLabel#TitleLabel {
  font-size: 18pt;
  font-weight: 700;
  color: #f3ead7;
  padding: 2px 4px;
}

QLabel#KeyLabel {
  font-family: "Consolas", "Courier New", monospace;
  font-size: 9pt;
  color: #f0ddad;
  padding: 2px 8px;
  background: rgba(0, 0, 0, 60);
  border: 1px solid rgba(255, 255, 255, 40);
  border-radius: 10px;
}

QFrame#Panel {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 rgba(70, 46, 28, 215),
                              stop:0.40 rgba(90, 60, 36, 215),
                              stop:0.70 rgba(68, 44, 26, 215),
                              stop:1 rgba(48, 31, 19, 215));
  border: 1px solid rgba(0, 0, 0, 160);
  border-radius: 16px;
}

QPushButton {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 #6b4a2a,
                              stop:0.45 #8a6235,
                              stop:1 #5b3f23);
  border: 1px solid rgba(0, 0, 0, 180);
  border-radius: 12px;
  padding: 8px 12px;
  color: #fff1d0;
  font-weight: 600;
}

QPushButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 #7a552f,
                              stop:0.45 #a0723b,
                              stop:1 #6a4827);
  border: 1px solid rgba(255, 255, 255, 40);
}

QPushButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 #4e351f,
                              stop:0.55 #6a4827,
                              stop:1 #3e2a18);
  padding-top: 9px;
  padding-bottom: 7px;
}

QGroupBox#WoodGroup {
  background: rgba(18, 26, 18, 110);
  border: 1px solid rgba(0, 0, 0, 160);
  border-radius: 18px;
  margin-top: 14px;
}

QGroupBox#WoodGroup::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 2px 10px;
  margin-left: 12px;
  color: #f2e6c8;
  font-weight: 700;
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 rgba(45, 30, 18, 210),
                              stop:1 rgba(20, 34, 22, 210));
  border: 1px solid rgba(0, 0, 0, 170);
  border-radius: 10px;
}

/* Inner groupboxes inside Attack tab */
QGroupBox#WoodGroupInner {
  background: rgba(0, 0, 0, 45);
  border: 1px solid rgba(255, 255, 255, 20);
  border-radius: 16px;
  margin-top: 14px;
}

QGroupBox#WoodGroupInner::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 2px 10px;
  margin-left: 12px;
  color: #f2e6c8;
  font-weight: 700;
  background: rgba(0, 0, 0, 35);
  border: 1px solid rgba(255, 255, 255, 18);
  border-radius: 10px;
}

QLabel#SmallHint {
  color: rgba(233, 242, 235, 180);
  font-size: 9pt;
}

QFrame#AttackTopBar {
  background: rgba(0, 0, 0, 45);
  border: 1px solid rgba(255, 255, 255, 20);
  border-radius: 14px;
}

QLabel#AttackInfo {
  color: #e7f2ea;
  font-weight: 600;
}

QLabel#UsedLabel, QLabel#LockedLabel {
  font-family: "Consolas", "Courier New", monospace;
  font-size: 9pt;
  color: #f0ddad;
  padding: 2px 8px;
  background: rgba(0, 0, 0, 50);
  border: 1px solid rgba(255, 255, 255, 25);
  border-radius: 10px;
}

QTextEdit#TextWell, QTextEdit#PreviewWell {
  background: rgba(0, 0, 0, 80);
  border: 1px solid rgba(255, 255, 255, 35);
  border-radius: 14px;
  padding: 10px;
  selection-background-color: rgba(209, 154, 58, 170);
  selection-color: #101010;
}

QTextEdit#PreviewWell {
  font-family: "Consolas", "Courier New", monospace;
  font-size: 9pt;
  color: #d7efe1;
}

QTableWidget#FreqTable, QTableWidget#MapTable {
  background: rgba(0, 0, 0, 70);
  border: 1px solid rgba(255, 255, 255, 35);
  border-radius: 14px;
  gridline-color: rgba(255, 255, 255, 22);
  selection-background-color: rgba(47, 107, 60, 160);
  selection-color: #f7fff9;
}

QHeaderView::section {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(55, 38, 24, 210),
                              stop:1 rgba(28, 20, 14, 210));
  color: #f4e7c8;
  padding: 5px 7px;
  border: 0px;
  border-right: 1px solid rgba(255, 255, 255, 25);
  font-weight: 700;
}

QTableWidget::item {
  padding: 3px;
}

QTableWidget {
  alternate-background-color: rgba(255, 255, 255, 10);
}

QLineEdit#MapEdit {
  background: rgba(0, 0, 0, 70);
  border: 1px solid rgba(255, 255, 255, 35);
  border-radius: 10px;
  padding: 3px 0px;
  color: #f0f6f0;
  font-weight: 700;
  min-height: 20px;
}

QLineEdit#MapEdit:focus {
  border: 1px solid rgba(209, 154, 58, 180);
  background: rgba(0, 0, 0, 85);
}

/* Locked assignment input: visible + read-only look */
QLineEdit#MapEdit[locked="true"] {
  background: rgba(47, 107, 60, 70);
  border: 1px solid rgba(47, 107, 60, 180);
  color: #f7fff9;
}

QLineEdit#MapEdit[locked="true"]:focus {
  border: 1px solid rgba(47, 107, 60, 180);
}

QCheckBox#LockBox {
  spacing: 6px;
}

QCheckBox#LockBox::indicator {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 35);
  background: rgba(0, 0, 0, 55);
}

QCheckBox#LockBox::indicator:checked {
  background: rgba(47, 107, 60, 170);
  border: 1px solid rgba(47, 107, 60, 220);
}

/* Tabs */
QTabWidget#Tabs::pane {
  border: 1px solid rgba(0, 0, 0, 160);
  background: rgba(18, 26, 18, 110);
  border-radius: 18px;
  padding: 8px;
}

QTabBar::tab {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(70, 46, 28, 200),
                              stop:1 rgba(40, 28, 18, 200));
  border: 1px solid rgba(0, 0, 0, 160);
  border-bottom: 0px;
  padding: 8px 14px;
  margin-right: 6px;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
  color: rgba(243, 234, 215, 220);
  font-weight: 700;
}

QTabBar::tab:hover {
  border: 1px solid rgba(255, 255, 255, 40);
}

QTabBar::tab:selected {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(105, 74, 42, 220),
                              stop:1 rgba(55, 38, 24, 220));
  color: #fff1d0;
}

/* Scrollbars */
QScrollBar:vertical {
  background: rgba(0, 0, 0, 50);
  width: 12px;
  margin: 10px 2px 10px 2px;
  border-radius: 6px;
}

QScrollBar::handle:vertical {
  background: rgba(140, 100, 55, 200);
  min-height: 24px;
  border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(175, 125, 70, 220);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}

QScrollBar:horizontal {
  background: rgba(0, 0, 0, 50);
  height: 12px;
  margin: 2px 10px 2px 10px;
  border-radius: 6px;
}

QScrollBar::handle:horizontal {
  background: rgba(140, 100, 55, 200);
  min-width: 24px;
  border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
  background: rgba(175, 125, 70, 220);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0px;
}
