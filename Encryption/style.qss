/* styles/ab_style.qss */

/* Maritime + Toulouse summer night:
   - deep navy + ink (water)
   - warm amber/pink (street lamps, brick)
   - teal/cyan highlights (reflections)
   - soft glass cards
*/

QWidget {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #061326,
    stop: 0.40 #120a2b,
    stop: 1 #062b3b
  );
  color: #f4f0ff;
  font-family: "Inter", "Segoe UI", Arial, sans-serif;
  font-size: 12px;
}

/* Header / top bar */
QFrame#HeaderBar {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 rgba(77, 213, 255, 0.18),
    stop: 0.45 rgba(255, 77, 109, 0.16),
    stop: 1 rgba(255, 183, 3, 0.14)
  );
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
}

QLabel#AppTitle {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 0.6px;
  color: #fff2e9;
}

QLabel#AppSubtitle {
  font-size: 12px;
  color: rgba(244, 240, 255, 0.78);
}

/* Status pill */
QLabel#StatusPillOk {
  background: rgba(77, 213, 255, 0.18);
  border: 1px solid rgba(77, 213, 255, 0.55);
  border-radius: 999px;
  padding: 8px 12px;
  color: #e8fbff;
  font-weight: 800;
}

QLabel#StatusPillBad {
  background: rgba(255, 77, 109, 0.16);
  border: 1px solid rgba(255, 77, 109, 0.55);
  border-radius: 999px;
  padding: 8px 12px;
  color: #ffe9ee;
  font-weight: 800;
}

/* Card containers */
QFrame#Card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
}

QLabel#CardTitle {
  font-size: 14px;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
}

/* Panels */
QFrame#ConfigPanel {
  background: rgba(6, 19, 38, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 14px;
}

QScrollArea#ScrollArea {
  background: transparent;
  border: none;
}

/* Inputs */
QLineEdit#Input,
QComboBox#Input,
QSpinBox#Input {
  background: rgba(7, 23, 44, 0.60);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 8px 10px;
  color: #f4f0ff;
}

QLineEdit#Input:focus,
QComboBox#Input:focus,
QSpinBox#Input:focus {
  border: 1px solid rgba(77, 213, 255, 0.55);
  background: rgba(7, 23, 44, 0.74);
}

/* Text areas */
QTextEdit#TextArea,
QTextEdit#LogArea,
QPlainTextEdit {
  background: rgba(7, 23, 44, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 10px;
  color: #f4f0ff;
  selection-background-color: rgba(255, 183, 3, 0.55);
  selection-color: #120a2b;
}

/* Lists */
QListWidget#List {
  background: rgba(7, 23, 44, 0.46);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 6px;
  color: rgba(244, 240, 255, 0.90);
}

QListWidget#List::item {
  padding: 10px 10px;
  margin: 4px 2px;
  border-radius: 12px;
}

QListWidget#List::item:selected {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 rgba(77, 213, 255, 0.48),
    stop: 0.55 rgba(255, 77, 109, 0.50),
    stop: 1 rgba(255, 183, 3, 0.50)
  );
  color: #061326;
  font-weight: 900;
}

/* Buttons */
QPushButton#PrimaryButton {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 1,
    stop: 0 #4dd5ff,
    stop: 0.55 #ff4d6d,
    stop: 1 #ffb703
  );
  color: #061326;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 14px;
  padding: 10px 14px;
  font-weight: 900;
}

QPushButton#PrimaryButton:hover {
  border: 1px solid rgba(255, 255, 255, 0.38);
}

QPushButton#PrimaryButton:pressed {
  background: rgba(255, 255, 255, 0.14);
  color: #f4f0ff;
}

QPushButton#GhostButton,
QPushButton#ToggleButton {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(244, 240, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 14px;
  padding: 10px 14px;
  font-weight: 800;
}

QPushButton#GhostButton:hover,
QPushButton#ToggleButton:hover {
  border: 1px solid rgba(77, 213, 255, 0.50);
}

QPushButton#ToggleButton:checked {
  background: rgba(255, 183, 3, 0.20);
  border: 1px solid rgba(255, 183, 3, 0.55);
  color: #fff2e9;
}

/* Labels / hints */
QLabel#FieldLabel {
  color: rgba(244, 240, 255, 0.84);
}

QLabel#Hint {
  color: rgba(244, 240, 255, 0.62);
  font-style: italic;
}

/* Scrollbars */
QScrollBar:vertical {
  background: rgba(255, 255, 255, 0.04);
  width: 12px;
  margin: 8px 6px 8px 6px;
  border-radius: 999px;
}

QScrollBar::handle:vertical {
  background: rgba(77, 213, 255, 0.28);
  min-height: 28px;
  border-radius: 999px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(255, 77, 109, 0.36);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0px;
}